# Self-hosted LiveSync — переменные окружения
# Скопируйте в .env и заполните. НЕ коммитьте .env в git.

# =============================================================================
# ОБЯЗАТЕЛЬНО — учётные данные CouchDB
# =============================================================================

COUCHDB_USER=obsidian
COUCHDB_PASSWORD=change_me_use_a_strong_password
COUCHDB_DATABASE=obsidiannotes

# Только localhost: снаружи доступ через Tailscale / Caddy / Cloudflare
COUCHDB_PORT=127.0.0.1:5984

# =============================================================================
# РЕКОМЕНДУЕТСЯ для ноутбука + Android без своего домена
# docker compose --profile tailscale up -d
# =============================================================================

# Ключ: https://login.tailscale.com/admin/settings/keys
# Создайте Reusable + Ephemeral auth key
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_HOSTNAME=basya-livesync

# =============================================================================
# Вариант с доменом (Let's Encrypt)
# docker compose --profile caddy up -d
# A-запись домена → 82.22.187.58, порты 80 и 443 открыты
# =============================================================================

COUCHDB_DOMAIN=sync.example.com
ACME_EMAIL=you@example.com

# =============================================================================
# Вариант Cloudflare Tunnel
# docker compose --profile cloudflare up -d
# =============================================================================

CF_TUNNEL_TOKEN=eyJhIjoixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
